root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.{kt,kts}]
max_line_length = 120
# Composables are PascalCase by convention, which ktlint's function-naming rule
# would otherwise reject on every one of them.
ktlint_function_naming_ignore_when_annotated_with = Composable
