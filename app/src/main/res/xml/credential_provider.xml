<?xml version="1.0" encoding="utf-8"?>
<!--
    Passwords only, for now. On Android 14 and newer a Credential Manager
    provider without an autofill service of its own is also offered ordinary
    login forms, through the platform's credential autofill bridge.
-->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
    </capabilities>
</credential-provider>
