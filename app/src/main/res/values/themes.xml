<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Passwords" parent="android:Theme.Material.NoActionBar" />

    <!-- The sign-in screens are dialogs over the app that asked; no window of their own shows. -->
    <style name="Theme.Passwords.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
