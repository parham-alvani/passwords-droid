<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <!-- Scaled to the 72dp safe zone rather than filling the 108dp canvas.
         A launcher masks to the middle two thirds, so full bleed art loses the
         ears, the key and the padlock. -->
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- A themed icon is tinted flat, so this is a silhouette (fur, padlock
         with its keyhole cut out, key and sparks) rather than the colour art,
         which would render as a solid blob. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
